// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  ticker    String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  financialYears    FinancialYear[]
  news              News[]
  resultFieldGroups ResultFieldGroup[]
  estimateScenarios EstimateScenario[]

  @@map("company")
}

enum Unit {
  million
  thousand
  one

  @@map("unit")
}

model FinancialYear {
  id        Int       @id @default(autoincrement())
  companyId Int       @map("company")
  name      String?
  unit      Unit?
  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportingSeasons ReportingSeason[]
  estimateRows     EstimateRow[]

  @@map("financial_year")
}

model ReportingSeason {
  id              Int       @id @default(autoincrement())
  financialYearId Int       @map("financial_year")
  name            String?
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  estimate        Boolean?
  // A person has checked the season's result values.
  confirmed       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  resultRows    ResultRow[]
  estimateRows  EstimateRow[]

  @@map("reporting_season")
}

// A section of a company's financial statements, e.g. tuloslaskelma, tase or rahavirtalaskelma.
model ResultFieldGroup {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  order     Int?
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultFields ResultField[]

  @@map("result_field_group")
}

// A single line in a group, e.g. liikevaihto in tuloslaskelma.
model ResultField {
  id                 Int          @id @default(autoincrement())
  resultFieldGroupId Int          @map("result_field_group")
  order              Int?
  name               String?
  fieldDefinitionId  Int?         @map("field_definition")
  // How the field is estimated, in every scenario and period.
  estimateType       EstimateType @default(relative) @map("estimate_type")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")

  resultFieldGroup ResultFieldGroup @relation(fields: [resultFieldGroupId], references: [id], onDelete: Cascade)
  fieldDefinition  FieldDefinition? @relation(fields: [fieldDefinitionId], references: [id], onDelete: SetNull)
  resultRows       ResultRow[]
  estimateRows     EstimateRow[]

  @@map("result_field")
}

// Definition for calculated fields.
model FieldDefinition {
  id         Int      @id @default(autoincrement())
  definition Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  resultFields ResultField[]

  @@map("field_definition")
}

// The value of a result field for one reporting season, in whole euros. Insert-only: a new
// value is a new row, and the latest row (by createdAt, id) per season and field is current.
model ResultRow {
  id                Int      @id @default(autoincrement())
  reportingSeasonId Int      @map("reporting_season")
  resultFieldId     Int      @map("result_field")
  value             BigInt?
  // News whose report the value was extracted from; null for values entered by hand.
  newsId            Int?     @map("news")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  reportingSeason ReportingSeason @relation(fields: [reportingSeasonId], references: [id], onDelete: Cascade)
  resultField     ResultField     @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)
  news            News?           @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@index([reportingSeasonId, resultFieldId, createdAt(sort: Desc)])
  @@map("result_row")
}

// A named set of estimates for a company, e.g. "Base", "Bull" or "Bear".
model EstimateScenario {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimateRows EstimateRow[]

  @@unique([companyId, name])
  @@map("estimate_scenario")
}

enum EstimateType {
  // Percent change compared to the same period a year earlier.
  relative
  // Value for the period in whole euros.
  absolute

  @@map("estimate_type")
}

// Estimate variable for one result field and period in a scenario. Insert-only like result_row:
// the latest row (by createdAt, id) per scenario, field and period is current. Quarterly estimates
// point to a reporting season, yearly ones to a financial year: exactly one of them is set
// (enforced by a check constraint in the migration).
model EstimateRow {
  id                 Int          @id @default(autoincrement())
  estimateScenarioId Int          @map("estimate_scenario")
  resultFieldId      Int          @map("result_field")
  reportingSeasonId  Int?         @map("reporting_season")
  financialYearId    Int?         @map("financial_year")
  // The field's estimate type when the value was entered. Rows of another type are ignored.
  type               EstimateType
  // relative: hundredths of a percent (348 = +3.48 %), absolute: whole euros. Null clears the
  // estimate.
  value              BigInt?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")

  estimateScenario EstimateScenario @relation(fields: [estimateScenarioId], references: [id], onDelete: Cascade)
  resultField      ResultField      @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)
  reportingSeason  ReportingSeason? @relation(fields: [reportingSeasonId], references: [id], onDelete: Cascade)
  financialYear    FinancialYear?   @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@index([estimateScenarioId, createdAt(sort: Desc)])
  @@map("estimate_row")
}

model News {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company")
  title       String
  description String
  releasedAt  DateTime @map("released_at")
  categoryId  Int      @map("category")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    NewsCategory     @relation(fields: [categoryId], references: [id])
  attachments NewsAttachment[]
  resultRows  ResultRow[]

  // Feeds list news newest first, either all of them or one company's.
  @@index([releasedAt(sort: Desc)])
  @@index([companyId, releasedAt(sort: Desc)])
  @@map("news")
}

// Category of a news item, matched by keywords when the news is received.
model NewsCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Phrases (Finnish or English) that identify the category in a release's subject or release line.
  keywords  String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  news News[]

  @@map("news_category")
}

model NewsAttachment {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news")
  url       String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("news_attachment")
}
