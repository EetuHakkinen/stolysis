// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id               Int                   @id @default(autoincrement())
  name             String
  ticker           String                @unique
  // Symbol of the company's stock in EODHD; null for the default, the ticker on Nasdaq Helsinki.
  priceSymbol      String?               @map("price_symbol")
  // When the stock prices were last fetched, successfully or not.
  pricesFetchedAt  DateTime?             @map("prices_fetched_at")
  // Why the latest fetch of the stock prices failed; null when it succeeded.
  pricesFetchError StockPriceFetchError? @map("prices_fetch_error")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")

  financialYears     FinancialYear[]
  news               News[]
  resultFieldGroups  ResultFieldGroup[]
  estimateScenarios  EstimateScenario[]
  valuationMultiples ValuationMultiple[]
  valuation          CompanyValuation?
  discountVariables  CompanyDiscountVariable[]
  graphs             Graph[]
  notes              Note[]
  stockPrices        StockPrice[]

  @@map("company")
}

// Why fetching stock prices failed: the daily request limit was used up, EODHD has no stock with the
// price symbol, or anything else.
enum StockPriceFetchError {
  quota
  notFound @map("not_found")
  failed

  @@map("stock_price_fetch_error")
}

enum Unit {
  million
  thousand
  one

  @@map("unit")
}

model FinancialYear {
  id        Int       @id @default(autoincrement())
  companyId Int       @map("company")
  name      String?
  unit      Unit?
  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")
  // A person has checked the year's values of fields reported only yearly.
  confirmed Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportingSeasons ReportingSeason[]
  resultRows       ResultRow[]
  estimateRows     EstimateRow[]
  valuations       CompanyValuation[]

  @@map("financial_year")
}

model ReportingSeason {
  id              Int       @id @default(autoincrement())
  financialYearId Int       @map("financial_year")
  name            String?
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  estimate        Boolean?
  // A person has checked the season's result values.
  confirmed       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  resultRows    ResultRow[]
  estimateRows  EstimateRow[]

  @@map("reporting_season")
}

// A section of a company's financial statements, e.g. tuloslaskelma, tase or rahavirtalaskelma.
model ResultFieldGroup {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  order     Int?
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultFields ResultField[]

  @@map("result_field_group")
}

// Special meaning of a result field that calculations rely on, e.g. the valuation and the DCF.
enum ResultFieldType {
  net_debt
  share_count
  operating_free_cash_flow
  dividend
  ebit
  depreciation
  taxes_paid
  working_capital_change
  capital_expenditure

  @@map("result_field_type")
}

// How a financial year's value is formed from its reporting seasons.
enum YearlyValue {
  // Sum of the seasons, e.g. liikevaihto.
  sum
  // Value of the last season, e.g. nettovelka.
  last_period
  // The field is reported only for whole financial years, e.g. kauden voitto in a financial
  // statements release. Its years have values of their own, and its seasons have none.
  yearly_only

  @@map("yearly_value")
}

// How a result field's values are shown.
enum ValueFormat {
  // In the financial year's unit, e.g. liikevaihto in M€.
  money
  // As is, with a percent sign, e.g. liikevoitto-%.
  percent

  @@map("value_format")
}

// A single line in a group, e.g. liikevaihto in tuloslaskelma.
model ResultField {
  id                 Int              @id @default(autoincrement())
  resultFieldGroupId Int              @map("result_field_group")
  order              Int?
  name               String?
  // Null for ordinary fields.
  type               ResultFieldType?
  // How the field is estimated, in every scenario and period.
  estimateType       EstimateType     @default(relative) @map("estimate_type")
  yearlyValue        YearlyValue      @default(sum) @map("yearly_value")
  valueFormat        ValueFormat      @default(money) @map("value_format")
  // Marked by the user in the settings.
  starred            Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  resultFieldGroup   ResultFieldGroup    @relation(fields: [resultFieldGroupId], references: [id], onDelete: Cascade)
  fieldDefinitions   FieldDefinition[]
  resultRows         ResultRow[]
  estimateRows       EstimateRow[]
  valuationMultiples ValuationMultiple[]
  graphFields        GraphField[]

  @@map("result_field")
}

// Which values a calculated field's formula produces.
enum FieldDefinitionKind {
  actual
  estimate

  @@map("field_definition_kind")
}

// Formula of a calculated field as a list of tokens (see lib/formulas.ts). A field with an actual
// definition is always calculated from other fields' actual values, and its result rows are
// ignored. A field with an estimate definition is calculated from other fields' predicted values,
// and its estimate rows are ignored.
model FieldDefinition {
  id            Int                 @id @default(autoincrement())
  resultFieldId Int                 @map("result_field")
  kind          FieldDefinitionKind
  definition    Json
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")

  resultField ResultField @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)

  @@unique([resultFieldId, kind])
  @@map("field_definition")
}

// The value of a result field for one reporting season, or for a financial year when the field is
// reported only yearly, in whole euros. Exactly one of the period ids is set (enforced by a check
// constraint in the migration). Insert-only: a new value is a new row, and the latest row (by
// createdAt, id) per period and field is current.
model ResultRow {
  id                Int      @id @default(autoincrement())
  reportingSeasonId Int?     @map("reporting_season")
  financialYearId   Int?     @map("financial_year")
  resultFieldId     Int      @map("result_field")
  value             BigInt?
  // News whose report the value was extracted from; null for values entered by hand.
  newsId            Int?     @map("news")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  reportingSeason ReportingSeason? @relation(fields: [reportingSeasonId], references: [id], onDelete: Cascade)
  financialYear   FinancialYear?   @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  resultField     ResultField      @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)
  news            News?            @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@index([reportingSeasonId, resultFieldId, createdAt(sort: Desc)])
  @@index([financialYearId, resultFieldId, createdAt(sort: Desc)])
  @@map("result_row")
}

// A named set of estimates for a company, e.g. "Base", "Bull" or "Bear".
model EstimateScenario {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimateRows   EstimateRow[]
  multipleValues ValuationMultipleValue[]

  @@unique([companyId, name])
  @@map("estimate_scenario")
}

enum EstimateType {
  // Percent change compared to the same period a year earlier.
  relative
  // Value for the period in whole euros.
  absolute

  @@map("estimate_type")
}

// Estimate variable for one result field and period in a scenario. Insert-only like result_row:
// the latest row (by createdAt, id) per scenario, field and period is current. Quarterly estimates
// point to a reporting season, yearly ones to a financial year: exactly one of them is set
// (enforced by a check constraint in the migration).
model EstimateRow {
  id                 Int          @id @default(autoincrement())
  estimateScenarioId Int          @map("estimate_scenario")
  resultFieldId      Int          @map("result_field")
  reportingSeasonId  Int?         @map("reporting_season")
  financialYearId    Int?         @map("financial_year")
  // The field's estimate type when the value was entered. Rows of another type are ignored.
  type               EstimateType
  // relative: hundredths of a percent (348 = +3.48 %), absolute: whole euros. Null clears the
  // estimate.
  value              BigInt?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")

  estimateScenario EstimateScenario @relation(fields: [estimateScenarioId], references: [id], onDelete: Cascade)
  resultField      ResultField      @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)
  reportingSeason  ReportingSeason? @relation(fields: [reportingSeasonId], references: [id], onDelete: Cascade)
  financialYear    FinancialYear?   @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@index([estimateScenarioId, createdAt(sort: Desc)])
  @@map("estimate_row")
}

enum ValuationBasis {
  // The multiple gives the enterprise value, e.g. EV/EBIT. Net debt is subtracted from it to get
  // the market value.
  enterprise_value
  // The multiple gives the market value, e.g. P/E.
  market_value

  @@map("valuation_basis")
}

// A valuation multiple of a company, e.g. P/E or EV/EBIT. The same multiples are used in every
// scenario; their values are per scenario.
model ValuationMultiple {
  id            Int            @id @default(autoincrement())
  companyId     Int            @map("company")
  name          String
  order         Int?
  // The field whose value in the target year is multiplied by the multiple.
  resultFieldId Int            @map("result_field")
  basis         ValuationBasis
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultField ResultField              @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)
  values      ValuationMultipleValue[]

  @@unique([companyId, name])
  @@map("valuation_multiple")
}

// Value of a valuation multiple in an estimate scenario. Insert-only like result_row: the latest row
// (by createdAt, id) per scenario and multiple is current.
model ValuationMultipleValue {
  id                  Int      @id @default(autoincrement())
  estimateScenarioId  Int      @map("estimate_scenario")
  valuationMultipleId Int      @map("valuation_multiple")
  // Hundredths (1250 = 12.50). Null clears the value.
  value               Int?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  estimateScenario  EstimateScenario  @relation(fields: [estimateScenarioId], references: [id], onDelete: Cascade)
  valuationMultiple ValuationMultiple @relation(fields: [valuationMultipleId], references: [id], onDelete: Cascade)

  @@index([estimateScenarioId, valuationMultipleId, createdAt(sort: Desc)])
  @@map("valuation_multiple_value")
}

// A company's valuation settings, the same in every scenario.
model CompanyValuation {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique @map("company")
  // The financial year whose estimates are valued.
  targetFinancialYearId Int?     @map("target_financial_year")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetFinancialYear FinancialYear? @relation(fields: [targetFinancialYearId], references: [id], onDelete: SetNull)

  @@map("company_valuation")
}

// Variables for discounting a company's future values to the present. The cost of equity and the
// WACC are calculated from these, so they aren't stored.
enum DiscountVariable {
  tax_rate
  // Share of debt in total capital, D / (D + E).
  target_debt_ratio
  cost_of_debt
  beta
  market_risk_premium
  liquidity_premium
  risk_free_rate
  terminal_growth

  @@map("discount_variable")
}

// Value of a discount variable for a company.
model CompanyDiscountVariable {
  id        Int              @id @default(autoincrement())
  companyId Int              @map("company")
  variable  DiscountVariable
  // Hundredths: percentages in hundredths of a percent (850 = 8.50 %), beta in hundredths
  // (120 = 1.20). Null clears the value.
  value     Int?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, variable])
  @@map("company_discount_variable")
}

model News {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company")
  title       String
  description String
  releasedAt  DateTime @map("released_at")
  categoryId  Int      @map("category")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    NewsCategory     @relation(fields: [categoryId], references: [id])
  attachments NewsAttachment[]
  resultRows  ResultRow[]
  notes       Note[]

  // Feeds list news newest first, either all of them or one company's.
  @@index([releasedAt(sort: Desc)])
  @@index([companyId, releasedAt(sort: Desc)])
  @@map("news")
}

// Category of a news item, matched by keywords when the news is received.
model NewsCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Phrases (Finnish or English) that identify the category in a release's subject or release line.
  keywords  String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  news News[]

  @@map("news_category")
}

model NewsAttachment {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news")
  url       String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("news_attachment")
}

// A chart of a company's result fields, shown below the tables in the result and estimate tabs
// with periods on the x-axis.
model Graph {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  name      String
  order     Int?
  // Marked by the user in the settings; only starred graphs are shown in the summary.
  starred   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields  GraphField[]

  @@unique([companyId, name])
  @@map("graph")
}

enum GraphFieldType {
  line
  bar

  @@map("graph_field_type")
}

enum GraphAxis {
  left
  right

  @@map("graph_axis")
}

// A result field shown in a graph as a line or bars, against the left or right y-axis.
model GraphField {
  id            Int            @id @default(autoincrement())
  graphId       Int            @map("graph")
  resultFieldId Int            @map("result_field")
  type          GraphFieldType @default(line)
  axis          GraphAxis      @default(left)
  order         Int?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  graph       Graph       @relation(fields: [graphId], references: [id], onDelete: Cascade)
  resultField ResultField @relation(fields: [resultFieldId], references: [id], onDelete: Cascade)

  @@unique([graphId, resultFieldId])
  @@map("graph_field")
}

// A user's note on a company, written in markdown. Its date is chosen by the user; the company's
// estimates and multiples are shown as they were at the end of that day (in Finnish time).
model Note {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company")
  date      DateTime @db.Date
  text      String
  // News the note is about, if any.
  newsId    Int?     @map("news")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  news    News?   @relation(fields: [newsId], references: [id], onDelete: SetNull)

  // Notes are listed newest first, either one company's or one news item's.
  @@index([companyId, date(sort: Desc)])
  @@index([newsId])
  @@map("note")
}

// A company's stock prices on a trading day, from EODHD. Prices are integers in thousandths of the
// currency (41.3 € is 41300). The adjusted close also accounts for later dividends and splits, so
// EODHD revises it for past days. Open, high, low and volume are null for days saved before they
// were fetched.
model StockPrice {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company")
  date          DateTime @db.Date
  open          Int?
  high          Int?
  low           Int?
  close         Int
  adjustedClose Int      @map("adjusted_close")
  // Number of shares traded.
  volume        BigInt?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("stock_price")
}
